{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Via Aprovacao",
  "version": "0.1.0",
  "identifier": "com.viaaprovacao.widget",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:3000/widget"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Via Aprovação",
        "width": 380,
        "height": 800,
        "minWidth": 320,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": true,
        "center": false,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
